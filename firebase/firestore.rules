rules_version = '2';

// ⚠️ MVP rules — open access for hardcoded test users.
// MUST be replaced before connecting real users / shipping to stores.
// Tracking work: tighten rules during the auth integration pass.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
