{
  "name": "yb-ride",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build:shared": "pnpm --filter @yb/shared build",
    "test:shared": "pnpm --filter @yb/shared test",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "passenger": "pnpm --filter @yb/passenger",
    "driver": "pnpm --filter @yb/driver",
    "staff": "pnpm --filter @yb/staff-web",
    "admin": "pnpm --filter @yb/admin-web"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
